---
const { title = 'Independent Film & Video', description = 'Cinematic video production and filmmaking portfolio.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{color-scheme:dark;--bg:#0b0b0b;--panel:#151515;--text:#f2f0eb;--muted:#a5a29c;--line:#30302d;--accent:#d5ff3f;--max:1240px}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.6}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}button,input,textarea,select{font:inherit}.wrap{width:min(var(--max),calc(100% - 48px));margin-inline:auto}.site-header{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12}.brand{font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-.05em;font-size:1.05rem;text-transform:uppercase}.brand span{color:var(--accent)}nav{display:flex;gap:28px;align-items:center;font-size:.9rem;color:#d1d0ca}nav a:hover,.text-link:hover{color:var(--accent)}.nav-cta,.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--accent);color:#101010;border:0;padding:13px 18px;font-weight:700;border-radius:2px;transition:transform .2s}.nav-cta:hover,.button:hover{transform:translateY(-2px)}.eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:700}.hero{padding:90px 0 60px}.hero h1,.page-heading h1{font-family:Manrope,sans-serif;letter-spacing:-.075em;line-height:.98;font-size:clamp(3.2rem,8.5vw,7.6rem);max-width:1000px;margin:22px 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero-copy{display:flex;justify-content:space-between;align-items:end;gap:32px}.hero-copy p{color:var(--muted);max-width:520px;font-size:1.08rem}.hero-actions{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-top:26px}.text-link{border-bottom:1px solid #777;padding:10px 0}.hero-frame{position:relative;aspect-ratio:16/7;background:linear-gradient(130deg,#252821,#111 60%,#333);overflow:hidden;margin-top:34px;border:1px solid #ffffff1a}.hero-frame:after{content:'REPLACE WITH YOUR SHOWREEL';position:absolute;inset:0;display:grid;place-items:center;color:#ffffff6b;font-size:.78rem;letter-spacing:.2em;text-align:center;padding:20px}.hero-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:1}.section{padding:76px 0}.section-top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.section h2,.page-heading h1{font-family:Manrope,sans-serif;letter-spacing:-.055em}.section h2{font-size:clamp(2rem,4vw,3.6rem);line-height:1.05;margin:8px 0}.muted{color:var(--muted)}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 22px}.project-card .thumb{aspect-ratio:16/9;background:#1d1d1a;overflow:hidden;position:relative;border:1px solid #ffffff12}.project-card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.project-card:hover .thumb img{transform:scale(1.035)}.thumb-placeholder{height:100%;display:grid;place-items:center;color:#79796e;font-size:.75rem;letter-spacing:.16em;text-align:center;padding:20px}.project-meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;margin-top:15px}.project-card h3{font-family:Manrope,sans-serif;font-size:1.45rem;letter-spacing:-.04em;margin:4px 0}.project-card p{margin:0;color:var(--muted);font-size:.94rem}.cta-band{background:var(--accent);color:#111;padding:48px;display:flex;justify-content:space-between;align-items:center;gap:24px}.cta-band h2{font-size:clamp(2rem,5vw,4.2rem);line-height:1;max-width:700px;margin:10px 0;letter-spacing:-.06em}.button-dark{background:#111;color:#fff}.page-heading{padding:72px 0 36px}.page-heading h1{font-size:clamp(3rem,7vw,6.2rem);margin:12px 0}.page-heading p{max-width:650px;color:var(--muted)}.project-detail{padding:54px 0 90px}.video-frame{aspect-ratio:16/9;background:#151515;border:1px solid #ffffff18}.video-frame iframe{width:100%;height:100%;border:0}.detail-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:56px;margin-top:40px}.detail-columns h1{font-family:Manrope,sans-serif;letter-spacing:-.06em;line-height:1.05;font-size:clamp(2.5rem,5vw,5rem);margin:8px 0 20px}.detail-columns p{color:#c5c2ba}.detail-facts{border-top:1px solid var(--line)}.fact{padding:16px 0;border-bottom:1px solid var(--line)}.fact small{display:block;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:5px}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}.contact-panel{background:var(--panel);padding:30px}.contact-panel label{display:block;font-size:.85rem;margin:16px 0 7px}.contact-panel input,.contact-panel textarea,.contact-panel select{width:100%;background:#0b0b0b;border:1px solid var(--line);color:var(--text);padding:12px}.contact-panel textarea{min-height:140px;resize:vertical}.site-footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:.85rem;margin-top:70px}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.empty-note{padding:26px;border:1px dashed #494943;color:var(--muted)}@media(max-width:700px){.wrap{width:min(var(--max),calc(100% - 32px))}.site-header{height:auto;min-height:72px;gap:18px}nav{gap:13px;font-size:.8rem}nav .nav-cta{display:none}.hero{padding-top:60px}.hero-copy,.section-top{align-items:start;flex-direction:column}.hero-frame{aspect-ratio:16/9}.project-grid,.contact-grid,.detail-columns{grid-template-columns:1fr}.project-grid{gap:26px}.section{padding:52px 0}.cta-band{padding:28px;align-items:start;flex-direction:column}.detail-columns{gap:22px}}
    </style>
  </head>
  <body>
    <header class="wrap site-header">
      <a class="brand" href="/">KALISZUK MEDIA<span>®</span></a>
      <nav aria-label="Main navigation">
        <a href="/work/">Work</a>
        <a href="/about/">About</a>
        <a href="/services/">Services</a>
        <a class="nav-cta" href="/contact/">Start a project ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner"><span>© {new Date().getFullYear()} Kaliszuk Media. All rights reserved.</span><span>Independent filmmaker · Video production</span><a href="/contact/">Have a project? Get in touch ↗</a></div></footer>
  </body>
</html>
