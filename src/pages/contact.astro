---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — KALISZUK MEDIA" description="Get in touch about a video production or creative project.">
  <section class="wrap page-heading"><div class="eyebrow">Start a conversation</div><h1>What's your<br/>next story?</h1><p>Tell me a little about what you're planning. I'll get back to you to talk through the idea, timeline and next steps.</p></section>
  <section class="wrap section" style="padding-top:12px"><div class="contact-grid"><div><h2 style="font-family:Manrope,sans-serif;font-size:2rem;letter-spacing:-.05em">Let's make it happen.</h2></div><div class="contact-panel"><div class="eyebrow">Project inquiry</div><p class="muted" style="font-size:.85rem">Form setup placeholder — connect a free Tally form before launching.</p><form action="https://tally.so/r/REPLACE_WITH_YOUR_FORM_ID" method="get" onsubmit="return false"><label for="name">Your name</label><input id="name" name="name" placeholder="Name" required /><label for="email">Email address</label><input id="email" name="email" type="email" placeholder="you@example.com" required /><label for="type">What kind of project?</label><select id="type" name="type"><option>Commercial / branded content</option><option>Music video</option><option>Event / documentary</option><option>Film / creative project</option><option>Editing / post-production</option><option>Something else</option></select><label for="budget">Approximate budget</label><select id="budget" name="budget"><option>Not sure yet</option><option>Under $1,000</option><option>$1,000–$3,000</option><option>$3,000–$7,500</option><option>$7,500+</option></select><label for="details">Tell me about the project</label><textarea id="details" name="details" placeholder="The idea, timing, location, or anything else..."></textarea><button class="button" type="button" onclick="alert('This demo form is not connected yet. Before launch, replace it with your Tally form embed.')">Send inquiry ↗</button></form></div></div></section>
</BaseLayout>
