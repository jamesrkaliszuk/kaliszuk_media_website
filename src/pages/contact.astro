---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — KALISZUK MEDIA" description="Get in touch about a video production or creative project.">
  <section class="wrap page-heading">
    <div class="eyebrow">Start a conversation</div>
    <h1>What's your<br/>next story?</h1>
    <p>Tell me a little about what you're planning. I'll get back to you to talk through the idea, timeline and next steps.</p>
  </section>

  <section class="wrap section" style="padding-top:12px">
    <div class="contact-grid">
      <div>
        <h2 style="font-family:Manrope,sans-serif;font-size:2rem;letter-spacing:-.05em">Let's make it happen.</h2>
        <p class="muted">Have a question or an idea in mind? Send me a few details and I'll be in touch.</p>
      </div>
      <div class="contact-panel">
        <div class="eyebrow">Project inquiry</div>
        <p class="muted" style="font-size:.85rem">Fill in the details below and your inquiry will be sent through Formspree.</p>
        <form action="https://formspree.io/f/mrppzrnl" method="POST">
          <input type="hidden" name="_subject" value="New project inquiry — KALISZUK MEDIA" />
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" placeholder="Name" autocomplete="name" required />
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
          <label for="type">What kind of project?</label>
          <select id="type" name="project_type" required>
            <option value="Commercial / branded content">Commercial / branded content</option>
            <option value="Music video">Music video</option>
            <option value="Event / documentary">Event / documentary</option>
            <option value="Film / creative project">Film / creative project</option>
            <option value="Editing / post-production">Editing / post-production</option>
            <option value="Something else">Something else</option>
          </select>
          <label for="budget">Approximate budget</label>
          <select id="budget" name="budget" required>
            <option value="Not sure yet">Not sure yet</option>
            <option value="Under $1,000">Under $1,000</option>
            <option value="$1,000–$3,000">$1,000–$3,000</option>
            <option value="$3,000–$7,500">$3,000–$7,500</option>
            <option value="$7,500+">$7,500+</option>
          </select>
          <label for="details">Tell me about the project</label>
          <textarea id="details" name="project_details" placeholder="The idea, timing, location, or anything else..." required></textarea>
          <button class="button" type="submit">Send inquiry ↗</button>
          <p class="muted" style="font-size:.75rem;margin-top:12px">Your information will be used to respond to your project inquiry.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
