---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Selected Work — KALISZUK MEDIA" description="Explore video production, films, branded content, music videos and more.">
  <section class="wrap page-heading"><div class="eyebrow">The portfolio</div><h1>Selected work.</h1><p>A collection of projects across formats, industries and ideas. Every project starts with a story worth telling.</p></section>
  <section class="wrap section" style="padding-top:20px">{projects.length ? <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div> : <div class="empty-note">No published projects yet. Add a project in Pages CMS and publish it to see it here.</div>}</section>
</BaseLayout>
