---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [{n:'01',title:'Commercial & branded films',text:'Cinematic storytelling for brands, products and campaigns.'},{n:'02',title:'Music videos',text:'Visual worlds that bring an artist, track or performance to life.'},{n:'03',title:'Events & documentary',text:'Real moments, real people and stories captured with care.'},{n:'04',title:'Editing & post-production',text:'Shaping footage into a clear, compelling final story.'}];
---
<BaseLayout title="Services — KALISZUK MEDIA" description="Video production services and creative collaboration.">
  <section class="wrap page-heading"><div class="eyebrow">What I do</div><h1>From first idea<br/>to final frame.</h1><p>Flexible creative support for projects big and small. These are starting points, tell me what you're working on and we can shape the right approach.</p></section>
  <section class="wrap section" style="padding-top:10px">{services.map(s => <div style="display:grid;grid-template-columns:70px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid var(--line)"><span class="eyebrow">{s.n}</span><div><h2 style="font-size:clamp(1.5rem,3vw,2.5rem);margin:0 0 8px">{s.title}</h2><p class="muted" style="margin:0">{s.text}</p></div></div>)}</section>
  <section class="wrap section"><div class="cta-band"><h2>Have a different kind of project?</h2><a class="button button-dark" href="/contact/">Tell me about it ↗</a></div></section>
</BaseLayout>
