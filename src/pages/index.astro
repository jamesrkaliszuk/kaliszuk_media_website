---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = projects.filter(p => p.data.featured).slice(0,4);
const showcase = featured.length ? featured : projects.slice(0,4);
const showreelId = '';
---
<BaseLayout title="YOUR NAME — Filmmaker & Video Production" description="Cinematic video production, branded content, films and visual storytelling.">
  <section class="wrap hero">
    <div class="eyebrow">Independent filmmaker · Video production</div>
    <h1>Stories told<br/>through <em>moving images.</em></h1>
    <div class="hero-copy"><div><p>From brand films to music videos, documentaries to the unexpected — I create cinematic work built to make people feel something.</p><div class="hero-actions"><a class="button" href="/contact/">Have a project? Let's talk ↗</a><a class="text-link" href="/work/">Explore selected work ↓</a></div></div><p>CREATIVE DIRECTION · FILMMAKING · EDITING<br/>Based wherever the story takes me.</p></div>
    <div class="hero-frame">{showreelId ? <iframe src={`https://www.youtube-nocookie.com/embed/${showreelId}?rel=0`} title="Showreel" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe> : null}</div>
  </section>
  <section class="wrap section">
    <div class="section-top"><div><div class="eyebrow">A selection of work</div><h2>Selected projects</h2></div><a class="text-link" href="/work/">View all projects ↗</a></div>
    {showcase.length ? <div class="project-grid">{showcase.map(project => <ProjectCard project={project} />)}</div> : <div class="empty-note">Your projects will appear here once you publish them in the CMS.</div>}
  </section>
  <section class="wrap section"><div class="cta-band"><div><div class="eyebrow" style="color:#111">Have something in mind?</div><h2>Let's make something worth watching.</h2></div><a class="button button-dark" href="/contact/">Start a project ↗</a></div></section>
</BaseLayout>
