---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = projects.filter(p => p.data.featured).slice(0,4);
const showcase = featured.length ? featured : projects.slice(0,4);

// Paste the ID from your YouTube showreel URL here.
// Example: youtube.com/watch?v=AbCdEf12345 -> use AbCdEf12345
const showreelId = '3r8pQ8j4Ojs';
const showreelUrl = showreelId
  ? `https://www.youtube-nocookie.com/embed/${showreelId}?autoplay=1&mute=1&loop=1&playlist=${showreelId}&controls=0&rel=0&playsinline=1&modestbranding=1`
  : '';
---
<BaseLayout title="YOUR NAME — Filmmaker & Video Production" description="Cinematic video production, branded content, films and visual storytelling.">
  <section class="hero hero-video">
    <div class="hero-media" aria-hidden="true">
      {showreelId ? <iframe src={showreelUrl} title="Background showreel" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe> : null}
    </div>
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <div class="eyebrow">Independent filmmaker · Video production</div>
      <h1>Stories told<br/>through <em>moving images.</em></h1>
      <div class="hero-copy">
        <div>
          <p>From brand films to music videos, documentaries to the unexpected — I create cinematic work built to make people feel something.</p>
          <div class="hero-actions">
            <a class="button" href="/contact/">Have a project? Let's talk ↗</a>
            <a class="text-link" href="/work/">Explore selected work ↓</a>
          </div>
        </div>
        <p class="hero-note">CREATIVE DIRECTION · FILMMAKING · EDITING<br/>Based wherever the story takes me.</p>
      </div>
      {!showreelId ? <p class="showreel-note">Add your YouTube showreel ID in <code>src/pages/index.astro</code> to activate the background video.</p> : null}
      <a class="scroll-cue" href="#selected-work" aria-label="Scroll to selected projects">SCROLL TO EXPLORE ↓</a>
    </div>
  </section>

  <section id="selected-work" class="wrap section">
    <div class="section-top"><div><div class="eyebrow">A selection of work</div><h2>Selected projects</h2></div><a class="text-link" href="/work/">View all projects ↗</a></div>
    {showcase.length ? <div class="project-grid">{showcase.map(project => <ProjectCard project={project} />)}</div> : <div class="empty-note">Your projects will appear here once you publish them in the CMS.</div>}
  </section>
  <section class="wrap section"><div class="cta-band"><div><div class="eyebrow cta-eyebrow">Have something in mind?</div><h2>Let's make something worth watching.</h2></div><a class="button button-dark" href="/contact/">Start a project ↗</a></div></section>
</BaseLayout>
